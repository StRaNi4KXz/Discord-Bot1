{
  "name": "@workspace/discord-bot",
  "version": "1.0.0",
  "private": true
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=cjs --outfile=dist/index.js --sourcemap --external:discord.js --external:node-cron",
    "typecheck": "tsc --noEmit",
    "start": "node --enable-source-maps dist/index.js"
  },
  "dependencies": {
    "discord.js": "^14.18.0",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/node-cron": "^3.0.11",
    "esbuild": "^0.27.3",
    "tsx": "catalog:",
    "typescript": "^5.9.0"
  }
}
